							"script": {
								"exec": [
									"// Получаем текст ответа",
									"let responseText = pm.response.text();",
									"",
									"// Используем регулярное выражение для поиска ID",
									"let idMatch = responseText.match(/ID:\\s*(\\d+)/);",
									"",
									"if (idMatch) {",
									"    // Извлекаем ID",
									"    let id = idMatch[1];",
									"    // Сохраняем ID в переменную окружения",
									"    pm.collectionVariables.set(\"product_id\", id);",
									"    // Выводим ID в консоль для проверки",
									"    console.log(\"Извлеченный ID:\", id);",
									"} else {",
									"    console.log(\"ID не найден в ответе\");",
									"}",
									"",
									"pm.test(\"Verify that status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Verify that response time is less than 2000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"pm.test(\"Verify that response body contains data that product is added\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"Продукт успешно добавлен с ID:\");",
